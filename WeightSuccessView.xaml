<UserControl x:Class="ProjectIRON.Views.WeightSuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#17191C">

        <StackPanel
            Width="450"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="Weight Saved"
                Foreground="White"
                FontSize="40"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,15"/>

            <TextBlock
                Text="✓"
                Foreground="LimeGreen"
                FontSize="62"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    Content="Log Another Weight"
                    Width="200"
                    Height="60"
                    FontSize="18"
                    Margin="0,0,20,0"
                    Click="LogAnotherButton_Click"/>

                <Button
                    Content="Back to Home"
                    Width="200"
                    Height="60"
                    FontSize="18"
                    Click="HomeButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>