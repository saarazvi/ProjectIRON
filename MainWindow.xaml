<Window x:Class="ProjectIRON.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project IRON v0.2"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
   

    <Grid Background="#17191C">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Permanent header -->
        <Grid Grid.Row="0" Background="#202327">

            <TextBlock
                Text="PROJECT IRON"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Margin="25,0,0,0"/>

            <TextBlock
                Text="Profile menu coming next"
                Foreground="#B8B8B8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,25,0"/>

        </Grid>

        <!-- The active UserControl appears here -->
        <ContentControl
            x:Name="MainContent"
            Grid.Row="1"/>

    </Grid>
</Window>
