<Window x:Class="ProjectIRON.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project IRON v0.1"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#17191C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="593*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>

        <StackPanel
                Width="280"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="210,0,0,0">

            <TextBlock
                Text="PROJECT IRON"
                Foreground="White"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"/>

            <TextBlock
                Text="Welcome !"
                Foreground="White"
                FontSize="22"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="What would you liek to do today ?"
                Foreground="#B8B8B8"
                FontSize="15"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>
            

            <Button
                Content="Log Weight"
                Height="48"
                Margin="0,0,0,14"
                FontSize="15"
                Click="WeightButton_Click"/>

            <Button
                Content="Log Workout"
                Height="48"
                Margin="0,0,0,14"
                FontSize="15"
                Click="WorkoutButton_Click"/>

            <Button
                Content="View Logs"
                Height="48"
                Margin="0,0,0,14"
                FontSize="15"
                Click="ViewLogsButton_Click"/>   

            <Button
                Content="Exit"
                Height="48"
                FontSize="15"
                Click="ExitButton_click"/>

        </StackPanel>

    </Grid>
</Window>
