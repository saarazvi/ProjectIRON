<UserControl x:Class="ProjectIRON.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectIRON"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#17191C">

        <StackPanel
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" Height="422" Margin="0,10,0,0">

            <TextBlock
                Text="Log Workout"
                Foreground="White"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,25" RenderTransformOrigin="0.471,0.94" Width="180"/>

            <TextBlock
                Text="Exercise"
                Foreground="White"
                Width="300"
                Margin="0,0,0,5" />

            <TextBox
                x:Name="ExerciseTextBox"
                Height="36"
                Width="300"
                Margin="0,0,0,15"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Sets"
                Foreground="White"
                Width="300"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="SetsTextBox"
                Height="36"
                Width="300"
                Margin="0,0,0,15"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Reps"
                Foreground="White"
                Width="300"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="RepsTextBox"
                Height="36"
                Width="300"
                Margin="0,0,0,15"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Weight"
                Foreground="White"
                Width="300"
                Margin="0,0,0,5"/>

            <Grid Margin="0,0,0,22" Width="300">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="WeightTextBox"
                    Grid.Column="0"
                    Height="36"
                    Margin="0,0,5,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <ComboBox
                    x:Name="WeightUnitComboBox"
                    Grid.Column="1"
                    Height="36"
                    SelectedIndex="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" HorizontalAlignment="Right" Width="90">

                    <ComboBoxItem Content="lb"/>
                    <ComboBoxItem Content="kg"/>

                </ComboBox>

            </Grid>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    Content="Save Workout"
                    Width="145"
                    Height="42"
                    Margin="0,0,12,0"
                    Click="SaveButton_Click"/>

                <Button
                    Content="Back"
                    Width="145"
                    Height="42"
                    Click="BackButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
