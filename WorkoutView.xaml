<UserControl x:Class="ProjectIRON.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectIRON"
             mc:Ignorable="d" 
             d:DesignHeight="700" 
             d:DesignWidth="1000">

    <Grid Background="#17191C">

        <Button
            Content="View History"
            Width="140"
            Height="38"
            FontSize="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,25,0"
            Click="ViewHistoryButton_Click"/>

        <StackPanel
            Width="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="Log Workout"
                Foreground="White"
                FontSize="40"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,10,0,10"/>

            <TextBlock
                Text="Exercise"
                Foreground="White"
                FontSize="15"
                Width="360"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="ExerciseTextBox"
                Width="360"
                Height="36"
                FontSize="15"
                Margin="0,0,0,18"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Sets"
                Foreground="White"
                FontSize="15"
                Width="360"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="SetsTextBox"
                Width="360"
                Height="36"
                FontSize="15"
                Margin="0,0,0,18"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Reps"
                Foreground="White"
                FontSize="15"
                Width="360"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="RepsTextBox"
                Width="360"
                Height="36"
                FontSize="15"
                Margin="0,0,0,18"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <TextBlock
                Text="Weight"
                Foreground="White"
                FontSize="15"
                Width="360"
                Margin="0,0,0,6"/>

            <Grid
                Width="360"
                Margin="0,0,0,28">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="WeightTextBox"
                    Grid.Column="0"
                    Height="36"
                    FontSize="15"
                    Margin="0,0,10,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>

                <ComboBox
                    x:Name="WeightUnitComboBox"
                    Grid.Column="1"
                    Height="36"
                    FontSize="15"
                    SelectedIndex="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">

                    <ComboBoxItem Content="lb"/>
                    <ComboBoxItem Content="kg"/>

                </ComboBox>

            </Grid>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    Content="Save Workout"
                    Width="170"
                    Height="40"
                    FontSize="15"
                    Margin="0,0,20,0"
                    Click="SaveButton_Click"/>

                <Button
                    Content="Back"
                    Width="170"
                    Height="40"
                    FontSize="15"
                    Click="BackButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
